#!/bin/sh
# noslop check script — delegates to npm scripts by tier
TIER="${NOSLOP_TIER:-${1:-fast}}"

case "$TIER" in
  fast)
    node ./noslop.js check --tier=fast
    ;;
  slow)
    node ./noslop.js check --tier=slow
    ;;
  ci)
    node ./noslop.js check --tier=ci
    ;;
  *)
    echo "Unknown tier: $TIER — use: fast, slow, or ci" >&2
    exit 1
    ;;
esac
